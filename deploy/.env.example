# TradingAgents-webGUI — deployment environment
# Copy to deploy/.env and fill in. NEVER commit the real .env.

# ------------------------------------------------------------------
# Cloudflare Tunnel (token mode — recommended)
#
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel ->
# choose "Cloudflared" -> copy the tunnel token (starts with eyJ...).
#
# The token authorizes an outbound-only connection from your VPS to
# Cloudflare. No inbound ports are opened on the VPS.
# ------------------------------------------------------------------
TUNNEL_TOKEN=changeme-paste-your-cloudflared-tunnel-token

# ------------------------------------------------------------------
# Public hostname served by this stack.
#
# Must EXACTLY match the public hostname you configure for the tunnel
# in the Cloudflare dashboard (same scheme-less bare hostname), because
# deploy/docker-compose.yml builds Traefik router rules from it.
# ------------------------------------------------------------------
DOMAIN=gui.example.com

# ------------------------------------------------------------------
# Application bearer gate (app-level auth, ADR 0005).
#
# Recommended. Protects /api/* except GET /api/health, which stays
# open for reverse-proxy health checks. The frontend asks for the
# token at login and sends it as a bearer header.
#
# Generate a strong token:
#   openssl rand -hex 32
#
# Leave empty to run without app-level auth (then consider enabling
# the optional Traefik basicAuth layer in docker-compose.yml).
# ------------------------------------------------------------------
TA_WEBGUI_API_TOKEN=

# ------------------------------------------------------------------
# File-mode tunnel (OPTIONAL alternative to token mode).
#
# Only used with the override file compose.override.filemode.yml (see
# deploy/cloudflared/README.md). Absolute path to the tunnel
# credentials JSON on the VPS. Never commit this file.
# ------------------------------------------------------------------
# CLOUDFLARED_CREDENTIALS_FILE=/srv/secrets/ta-webgui-<uuid>.json

# ------------------------------------------------------------------
# Traefik edge middleware tuning (see docker-compose.yml labels).
#
# rateLimit on /api: token-bucket, average requests per second with a
# burst allowance. Note: behind the tunnel, per-IP granularity relies
# on X-Forwarded-For relayed from Cloudflare; if that header chain is
# ever missing, the bucket degrades to one shared bucket (still a
# useful abuse brake).
# ------------------------------------------------------------------
RATE_LIMIT_AVERAGE=10
RATE_LIMIT_BURST=20

# Global cap on concurrent in-flight requests hitting /api (also
# bounds simultaneous SSE streams). Size for your VPS: each analysis
# run holds one SSE connection.
INFLIGHT_LIMIT=20

# ------------------------------------------------------------------
# Persistence override (optional).
#
# By default run reports persist in the named docker volume
# `server_data`. Uncomment to bind-mount a host directory instead.
# ------------------------------------------------------------------
# PERSIST_DIR=/srv/ta-webgui-data
